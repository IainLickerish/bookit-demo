# Copy to terraform.tfvars (ignored by git) and set real values before applying from the owner's machine.
aws_account_id     = "123456789012"
demo_domain        = "demo.example.com"
budget_monthly_usd = 25 # placeholder: set the real monthly amount
budget_alert_email = "owner@example.com"

# Route 53 hosted zone for demo_domain, or leave null and create the A records from the host_addresses output.
dns_zone_id = null

