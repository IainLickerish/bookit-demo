# Names only. Never commit values: this repository is public.
DATABASE_URL=
# Container identity (plan 12.6). Outside local, BOOKIT_PRODUCT and
# BOOKIT_TENANT are required and the build must carry a 40-character
# GIT_COMMIT, or the server refuses to start.
BOOKIT_PRODUCT=
BOOKIT_TENANT=
# local, staging or production.
BOOKIT_ENV=
# Set per deployment by `deploy` and `bun run demo:deploy`.
BOOKIT_DEPLOYMENT_ID=
# Error reporting. Locally and in tests this points at fake-sentry; unset
# means nothing is reported anywhere.
BOOKIT_SENTRY_DSN=
# Confirmation emails go to Mailpit (smtp://mailpit:1025). Unset means no
# email is sent. Every sender and recipient must be on a .test domain.
BOOKIT_SMTP_URL=
BOOKIT_MAIL_FROM=
# When set, logs are also written to <dir>/<product>/<environment>.jsonl
# for SupportAgents' FakeLogSource.
BOOKIT_LOG_DIR=
# Test-clock builds only (build argument BOOKIT_ALLOW_TEST_CLOCK=true):
# path of the shared virtual clock file. Any other build refuses to start
# when this is set.
BOOKIT_TEST_CLOCK=
# Build arguments, read by `next build` only: GIT_COMMIT (required),
# BUILD_ID, BOOKIT_IMAGE, BUILT_AT and BOOKIT_ALLOW_TEST_CLOCK.
